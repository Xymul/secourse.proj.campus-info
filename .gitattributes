# 统一换行符，避免 Windows 上编辑的 shell 脚本在 Linux 下因 CRLF 无法执行
* text=auto

# Linux / macOS 脚本与配置：必须 LF
*.sh        text eol=lf
mvnw        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sql       text eol=lf
*.java      text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.env       text eol=lf
*.example   text eol=lf

# Windows 脚本：保持 CRLF
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jar binary

# 语言与自动判定
*.md        text
