# 此刻校园 · 后端服务环境变量（复制到 /etc/campus/campus.env 后按需修改）
# 这些变量与 backend/src/main/resources/application.yml 的默认值一一对应。

# 数据库连接（必填）：与 PostgreSQL 实际部署保持一致
DB_URL=jdbc:postgresql://127.0.0.1:5432/campus_info
DB_USERNAME=postgres
DB_PASSWORD=postgres

# 运行环境：postgres（默认）或 h2（内存库，仅用于临时演示）
SPRING_PROFILES_ACTIVE=postgres

# 演示数据开关与规模（生产上线后建议设为 false，避免写入模拟信息）
CAMPUS_SEED_ENABLED=true
CAMPUS_MOCK_POSTS=1560

# 时区
TZ=Asia/Shanghai
